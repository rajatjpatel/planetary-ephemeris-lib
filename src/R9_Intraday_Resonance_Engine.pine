//@version=6
indicator('R9 Intraday Resonance Engine', shorttitle='R9-IRE', overlay=true, max_lines_count=500)

// ==========================================
// INTRADAY PLANETARY RESONANCE ENGINE (R9-IRE)
// ==========================================
// Integration of:
// - VSOP87D Heliocentric Planetary Positions
// - ELP2000-82 Geocentric Lunar Positions
// - Gann Price-to-Degree Normalization
// - Compression Spread (Planetary Clustering) Detection
// - Mean Daily Lunar Velocity (13.2°/day) Time Projection
// ==========================================

// ==========================================
// 1. UI SETTINGS
// ==========================================
group_anchor    = "ANCHOR SETTINGS"
anchorType      = input.string("High", "Anchor Price", options=["High", "Low"], group=group_anchor)
anchorTimeIn    = input.time(timestamp("2026-01-01 00:00"), "Anchor Date & Time", group=group_anchor)
timeFormat      = input.string("24-Hour", "Time Display Format", options=["12-Hour", "24-Hour"], group=group_anchor)

group_planets   = "PLANETARY CYCLES"
planetSelect    = input.string("All", "Select Cycles", options=["☉ Mercury", "☀ Venus", "❄ Mars", "❤ Jupiter", "⚑ Saturn", "☉ Sun", "☁ Moon", "All"], group=group_planets)
showHelio       = input.bool(true, "Show Heliocentric", group=group_planets)
showGeo         = input.bool(false, "Show Geocentric", group=group_planets)

group_cluster   = "COMPRESSION SETTINGS"
clusterThresh   = input.float(15.0, "Cluster Threshold (°)", minval=1.0, maxval=60.0, group=group_cluster)
mdlv            = input.float(13.2, "Mean Daily Lunar Velocity (°/day)", minval=10.0, maxval=15.5, group=group_cluster)
showSpread      = input.bool(true, "Show Compression Spreads", group=group_cluster)
showProjection  = input.bool(true, "Show Timing Projections", group=group_cluster)

group_visuals   = "VISUALS"
lineStyle       = input.string('Dashed', 'Line Style', options=['Solid', 'Dashed', 'Dotted'], group=group_visuals)
lineWidth       = input.int(2, "Line Width", minval=1, maxval=3, group=group_visuals)
labelSize       = input.string("small", "Label Size", options=["tiny", "small", "normal", "large"], group=group_visuals)

// ==========================================
// 2. COLORS & STYLING
// ==========================================
colorMerc   = color.new(color.fuchsia, 20)
colorVenus  = color.new(color.lime, 20)
colorMars   = color.new(color.red, 20)
colorJup    = color.new(color.orange, 20)
colorSat    = color.new(color.blue, 20)
colorSun    = color.new(color.yellow, 20)
colorMoon   = color.new(color.white, 20)
colorSpread = color.new(color.aqua, 30)
colorProj   = color.new(color.purple, 40)

// ==========================================
// 3. MATH CONSTANTS & HELPERS
// ==========================================
var float PI         = 3.141592653589793
var float RAD_TO_DEG = 180.0 / PI
var float DEG_TO_RAD = PI / 180.0

mod360(float val) =>
    float res = val % 360.0
    res < 0 ? res + 360.0 : res

getStyle(s) => s == 'Solid' ? line.style_solid : s == 'Dotted' ? line.style_dotted : line.style_dashed

// ==========================================
// 4. TIME CONVERSION HELPERS
// ==========================================
r9_get_t_mill(float ms) =>
    jd = ms / 86400000.0 + 2440587.5
    (jd - 2451545.0) / 365250.0

r9_get_T_cent(float ms) =>
    jd = ms / 86400000.0 + 2440587.5
    (jd - 2451545.0) / 36525.0

// ==========================================
// 5. VSOP87D EVALUATOR
// ==========================================
r9_vsop_eval(array<float> amps, array<float> phases, array<float> freqs, float t) =>
    float sum = 0.0
    int sz = array.size(amps)
    for i = 0 to sz - 1
        sum += array.get(amps, i) * math.cos(array.get(phases, i) + array.get(freqs, i) * t)
    sum

// ==========================================
// 6. MERCURY HELIOCENTRIC LONGITUDE (VSOP87D)
// ==========================================
r9_mer_helio_lon(float t) =>
    array<float> L0a = array.from(4.40250710144, 0.40989414977, 0.05046294199, 0.00855346844, 0.00585979278)
    array<float> L0p = array.from(0.0, 1.48302034195, 4.47785489540, 1.16520322459, 4.22090402969)
    array<float> L0f = array.from(0.0, 26087.90314157420, 52175.80628314840, 78263.70942472259, 104351.61256629678)
    array<float> L1a = array.from(26088.14706222746, 0.01126007832, 0.00303471395, 0.00121281763)
    array<float> L1p = array.from(0.0, 6.21703970996, 3.05565472363, 6.01064153797)
    array<float> L1f = array.from(0.0, 26087.90314157420, 52175.80628314840, 78263.70942472259)
    float lon_rad = r9_vsop_eval(L0a, L0p, L0f, t) + r9_vsop_eval(L1a, L1p, L1f, t) * t
    mod360(lon_rad * RAD_TO_DEG)

// ==========================================
// 7. VENUS HELIOCENTRIC LONGITUDE (VSOP87D)
// ==========================================
r9_ven_helio_lon(float t) =>
    array<float> L0a = array.from(3.17614666774, 0.01353968419, 0.00089891645, 0.00005477194, 0.00003455741)
    array<float> L0p = array.from(0.0, 5.59313319619, 5.30650047764, 4.41630661466, 2.69964470778)
    array<float> L0f = array.from(0.0, 10213.28554621100, 20426.57109242200, 7860.41939243920, 11790.62908865880)
    array<float> L1a = array.from(10213.52943052898, 0.00095617813, 0.00007787201, 0.00000951697)
    array<float> L1p = array.from(0.0, 2.46406511110, 0.62478482220, 1.31712790883)
    array<float> L1f = array.from(0.0, 10213.28554621100, 20426.57109242200, 26.29831979980)
    float lon_rad = r9_vsop_eval(L0a, L0p, L0f, t) + r9_vsop_eval(L1a, L1p, L1f, t) * t
    mod360(lon_rad * RAD_TO_DEG)

// ==========================================
// 8. MARS HELIOCENTRIC LONGITUDE (VSOP87D)
// ==========================================
r9_mar_helio_lon(float t) =>
    array<float> L0a = array.from(6.20347711581, 0.18656368093, 0.01108216792, 0.00091798394, 0.00027744987)
    array<float> L0p = array.from(0.0, 5.05037100303, 5.40099836958, 5.75478744667, 5.97049512942)
    array<float> L0f = array.from(0.0, 3340.61242669980, 6681.22485339960, 10021.83728009940, 3.52311834900)
    array<float> L1a = array.from(3340.85627474342, 0.01458227051, 0.00164901343, 0.00019963338)
    array<float> L1p = array.from(0.0, 3.60426053609, 3.92631250962, 4.26594061030)
    array<float> L1f = array.from(0.0, 3340.61242669980, 6681.22485339960, 10021.83728009940)
    float lon_rad = r9_vsop_eval(L0a, L0p, L0f, t) + r9_vsop_eval(L1a, L1p, L1f, t) * t
    mod360(lon_rad * RAD_TO_DEG)

// ==========================================
// 9. JUPITER HELIOCENTRIC LONGITUDE (VSOP87D)
// ==========================================
r9_jup_helio_lon(float t) =>
    array<float> L0a = array.from(0.59954691494, 0.09695898711, 0.00573610142, 0.00306389180, 0.00097178296)
    array<float> L0p = array.from(0.0, 5.06191793105, 1.44406205629, 5.41734729976, 4.14264726552)
    array<float> L0f = array.from(0.0, 529.69096509460, 7.11354700080, 1059.38193018920, 632.78373931320)
    array<float> L1a = array.from(529.93480757497, 0.00489741194, 0.00228918538, 0.00027655380)
    array<float> L1p = array.from(0.0, 4.22066689928, 6.02647464016, 4.57265956824)
    array<float> L1f = array.from(0.0, 529.69096509460, 7.11354700080, 1059.38193018920)
    float lon_rad = r9_vsop_eval(L0a, L0p, L0f, t) + r9_vsop_eval(L1a, L1p, L1f, t) * t
    mod360(lon_rad * RAD_TO_DEG)

// ==========================================
// 10. SATURN HELIOCENTRIC LONGITUDE (VSOP87D)
// ==========================================
r9_sat_helio_lon(float t) =>
    array<float> L0a = array.from(0.87401354029, 0.11107659780, 0.01414150957, 0.00398379386, 0.00350769223)
    array<float> L0p = array.from(0.0, 3.96205090159, 4.58581515873, 0.52112025957, 3.30329907896)
    array<float> L0f = array.from(0.0, 213.29909543800, 7.11354700080, 206.18554843720, 426.59819087600)
    array<float> L1a = array.from(213.54295595986, 0.01296855005, 0.00564347566, 0.00098323030, 0.00107678770)
    array<float> L1p = array.from(0.0, 1.82820544701, 2.88500136429, 1.08070061328, 2.27769911872)
    array<float> L1f = array.from(0.0, 213.29909543800, 7.11354700080, 426.59819087600, 206.18554843720)
    float lon_rad = r9_vsop_eval(L0a, L0p, L0f, t) + r9_vsop_eval(L1a, L1p, L1f, t) * t
    mod360(lon_rad * RAD_TO_DEG)

// ==========================================
// 11. EARTH/SUN HELIOCENTRIC LONGITUDE (VSOP87D)
// ==========================================
r9_earth_helio_lon(float t) =>
    array<float> L0a = array.from(1.75347045673, 0.03341656456, 0.00034894275, 0.00003417571, 0.00003497056)
    array<float> L0p = array.from(0.0, 4.66925680417, 4.62610241759, 2.82886579606, 2.74411800971)
    array<float> L0f = array.from(0.0, 6283.07584999140, 12566.15169998280, 3.52311834900, 5753.38488489680)
    array<float> L1a = array.from(6283.31966747491, 0.00206058863, 0.00004303419, 0.00000425264)
    array<float> L1p = array.from(0.0, 2.67823455584, 2.63512233481, 1.59046980729)
    array<float> L1f = array.from(0.0, 6283.07584999140, 12566.15169998280, 3.52311834900)
    float lon_rad = r9_vsop_eval(L0a, L0p, L0f, t) + r9_vsop_eval(L1a, L1p, L1f, t) * t
    mod360(lon_rad * RAD_TO_DEG)

// ==========================================
// 12. MOON GEOCENTRIC LONGITUDE (ELP2000-82 — simplified)
// ==========================================
r9_moon_get_fundamentals(float T) =>
    float Lp = 218.3164477 + 481267.88123421 * T - 0.0015786 * T*T + T*T*T / 545868.0 - T*T*T*T / 113065000.0
    float D  = 297.8501921 + 445267.1114034  * T - 0.0018819 * T*T + T*T*T / 545868.0 - T*T*T*T / 113065000.0
    float M  = 357.5291092 + 35999.0502909   * T - 0.0001536 * T*T + T*T*T / 24490000.0
    float Mp = 134.9633964 + 477198.8675055  * T + 0.0087414 * T*T + T*T*T / 69699.0   - T*T*T*T / 14712000.0
    float F  = 93.2720950  + 483202.0175238  * T - 0.0036539 * T*T - T*T*T / 3526000.0 + T*T*T*T / 863310000.0
    [Lp, D, M, Mp, F]

r9_moon_geo_lon(float ms) =>
    float T = r9_get_T_cent(ms)
    [Lp, D, M, Mp, F] = r9_moon_get_fundamentals(T)
    mod360(Lp)

// ==========================================
// 13. ANCHOR DETECTION & GANN NORMALIZATION
// ==========================================
var float anchorPrice = na
var int   anchorTime  = na
var bool  anchorFound = false

bool _anchorDayMatch = dayofmonth(time, syminfo.timezone) == dayofmonth(anchorTimeIn, syminfo.timezone) and
     month(time, syminfo.timezone) == month(anchorTimeIn, syminfo.timezone) and
     year(time, syminfo.timezone) == year(anchorTimeIn, syminfo.timezone)
bool _anchorMatch = timeframe.isdwm ? _anchorDayMatch : time >= anchorTimeIn

if not anchorFound and _anchorMatch
    anchorPrice := anchorType == "High" ? high : low
    anchorTime  := time
    anchorFound := true

// Gann normalization: map price to 0-360° circle
gann_angle = anchorFound ? mod360(math.sqrt(anchorPrice) * 180.0 - 225.0) : na
square_angle = anchorFound ? mod360(math.sqrt(anchorPrice)) : na
price_mod360 = anchorFound ? mod360(anchorPrice) : na

// ==========================================
// 14. LIVE PLANETARY POSITION SNAPSHOT
// ==========================================
var line[] linePool = array.new_line()
var label[] labelPool = array.new<label>()

if barstate.islast and anchorFound
    // Clear old lines and labels
    if array.size(linePool) > 0
        for i = 0 to array.size(linePool) - 1
            line.delete(array.get(linePool, i))
        array.clear(linePool)
    
    if array.size(labelPool) > 0
        for i = 0 to array.size(labelPool) - 1
            label.delete(array.get(labelPool, i))
        array.clear(labelPool)
    
    // Time parameters for speed calculation (5-min step for intraday)
    float t0_mill = r9_get_t_mill(float(anchorTime))
    float t1_mill = r9_get_t_mill(float(anchorTime + 300000))  // 5 minutes
    
    // ==========================================
    // 15. CAPTURE PLANETARY POSITIONS
    // ==========================================
    array<float> planet_lons = array.new<float>()
    array<string> planet_names = array.new<string>()
    array<color> planet_colors = array.new<color>()
    
    if planetSelect == "☉ Mercury" or planetSelect == "All"
        float merc_lon = r9_mer_helio_lon(t0_mill)
        array.push(planet_lons, merc_lon)
        array.push(planet_names, "Mercury")
        array.push(planet_colors, colorMerc)
    
    if planetSelect == "☀ Venus" or planetSelect == "All"
        float ven_lon = r9_ven_helio_lon(t0_mill)
        array.push(planet_lons, ven_lon)
        array.push(planet_names, "Venus")
        array.push(planet_colors, colorVenus)
    
    if planetSelect == "❄ Mars" or planetSelect == "All"
        float mars_lon = r9_mar_helio_lon(t0_mill)
        array.push(planet_lons, mars_lon)
        array.push(planet_names, "Mars")
        array.push(planet_colors, colorMars)
    
    if planetSelect == "❤ Jupiter" or planetSelect == "All"
        float jup_lon = r9_jup_helio_lon(t0_mill)
        array.push(planet_lons, jup_lon)
        array.push(planet_names, "Jupiter")
        array.push(planet_colors, colorJup)
    
    if planetSelect == "⚑ Saturn" or planetSelect == "All"
        float sat_lon = r9_sat_helio_lon(t0_mill)
        array.push(planet_lons, sat_lon)
        array.push(planet_names, "Saturn")
        array.push(planet_colors, colorSat)
    
    if planetSelect == "☉ Sun" or planetSelect == "All"
        float sun_lon = r9_earth_helio_lon(t0_mill)
        array.push(planet_lons, sun_lon)
        array.push(planet_names, "Sun")
        array.push(planet_colors, colorSun)
    
    if planetSelect == "☁ Moon" or planetSelect == "All"
        float moon_lon = r9_moon_geo_lon(anchorTime)
        array.push(planet_lons, moon_lon)
        array.push(planet_names, "Moon")
        array.push(planet_colors, colorMoon)
    
    // ==========================================
    // 16. DETECT COMPRESSION SPREADS (CLUSTERS)
    // ==========================================
    int n_planets = array.size(planet_lons)
    array<float> spreads = array.new<float>()
    
    for i = 0 to n_planets - 1
        for j = i + 1 to n_planets - 1
            float lon_i = array.get(planet_lons, i)
            float lon_j = array.get(planet_lons, j)
            float delta_spread = math.abs(lon_j - lon_i)
            if delta_spread > 180.0
                delta_spread := 360.0 - delta_spread
            if delta_spread <= clusterThresh
                array.push(spreads, delta_spread)
    
    // Find max spread (compression)
    float max_spread = 0.0
    if array.size(spreads) > 0
        for i = 0 to array.size(spreads) - 1
            if array.get(spreads, i) > max_spread
                max_spread := array.get(spreads, i)
    
    // Initialize time variables
    float time_days = 0.0
    float time_hours = 0.0
    
    // ==========================================
    // 17. TIME PROJECTION ENGINE
    // ==========================================
    if max_spread > 0.0
        time_days := max_spread / mdlv
        time_hours := time_days * 24.0
        
        if showProjection
            int projection_time_ms = anchorTime + int(time_days * 86400000.0)
            
            // Draw timing projection line
            line proj_line = line.new(projection_time_ms, anchorPrice, projection_time_ms, anchorPrice + 10, 
                                       xloc.bar_time, extend.both, colorProj, getStyle(lineStyle), lineWidth)
            array.push(linePool, proj_line)
            
            // Label with exact projection time
            string time_str = timeFormat == "12-Hour" ?
                 str.format_time(projection_time_ms, "hh:mm a", syminfo.timezone) :
                 str.format_time(projection_time_ms, "HH:mm", syminfo.timezone)
            string proj_label = str.tostring(time_hours, "0.0##") + "h @ " + time_str
            
            label lbl_proj = label.new(projection_time_ms, anchorPrice + 15, proj_label, 
                                        xloc.bar_time, yloc.abovebar, colorProj, label.style_label_down, 
                                        color.gray, labelSize)
            array.push(labelPool, lbl_proj)
    
    // ==========================================
    // 18. DRAW ANCHOR REFERENCE LINE
    // ==========================================
    line ref_ln = line.new(anchorTime, anchorPrice, anchorTime, anchorPrice + 5, 
                            xloc.bar_time, extend.both, color.new(color.white, 50), line.style_solid, 1)
    array.push(linePool, ref_ln)
    
    // ==========================================
    // 19. SUMMARY LABEL
    // ==========================================
    string anchor_str = timeFormat == "12-Hour" ?
         str.format_time(anchorTime, "MMM dd, hh:mm a", syminfo.timezone) :
         str.format_time(anchorTime, "MMM dd, HH:mm", syminfo.timezone)
    
    float display_hours = max_spread > 0.0 ? time_hours : 0.0
    
    string summary = "INTRADAY RESONANCE WINDOW\n" +
                     "Anchor: " + anchor_str + "\n" +
                     "Price: " + str.tostring(anchorPrice, format.mintick) + "\n" +
                     "Compression: " + str.tostring(max_spread, "0.##") + "°\n" +
                     "Projection: " + str.tostring(display_hours, "0.0##") + " hours"
    
    label lbl_summary = label.new(anchorTime, anchorPrice, summary,
                                   xloc.bar_time, yloc.belowbar, color.new(color.gray, 80),
                                   label.style_label_center, color.white, labelSize)
    array.push(labelPool, lbl_summary)

// ==========================================
// FOOTER
// ==========================================
plot(0, "—", color=na)  // Invisible reference for line management
